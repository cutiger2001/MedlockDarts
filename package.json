{
  "name": "darts-league-app",
  "version": "1.0.0",
  "private": true,
  "description": "Dart scoring app with league play, statistics tracking, and multiple game types",
  "scripts": {
    "run": "npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "test:generate-season": "powershell -ExecutionPolicy Bypass -File scripts/test-generate-season.ps1",
    "build": "npm run build:client && npm run build:server",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "start": "cd server && npm run start",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "mssql": "^12.2.0",
    "xlsx": "^0.18.5"
  }
}
